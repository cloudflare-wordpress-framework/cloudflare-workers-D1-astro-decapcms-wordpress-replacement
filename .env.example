# Astro Site Configuration
PUBLIC_SITE_URL=https://my-astro-site.com

# Cloudflare D1 Database
CLOUDFLARE_D1_DATABASE_NAME=user-db
CLOUDFLARE_D1_DATABASE_ID=your-database-id-here

# Decap CMS Configuration
DECAP_GITHUB_REPO=owner/web-frontend
WORKER_API_URL=https://your-worker-url.workers.dev

# Cloudflare Worker Secrets (Required for GitHub OAuth & Uploads)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_PAT=your_github_personal_access_token

# Firebase Configuration (Optional for frontend auth)
PUBLIC_FIREBASE_API_KEY=your_api_key
PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your_project_id
