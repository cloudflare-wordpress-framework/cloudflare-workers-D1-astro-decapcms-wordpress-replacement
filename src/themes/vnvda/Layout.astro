---
import '../../styles/global.css';
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Hội Bệnh Mạch Máu Việt Nam</title>
	</head>
	<body class="bg-slate-100 text-gray-800 font-sans min-h-screen flex flex-col">
		<!-- Header Banner -->
		<div class="bg-white">
			<div class="max-w-6xl mx-auto px-4 py-4 flex flex-col md:flex-row items-center justify-between gap-4">
				<a href="/" class="flex items-center gap-3">
                    <div class="w-16 h-16 bg-red-600 rounded-full flex items-center justify-center text-white font-bold text-xl shadow-md border-4 border-red-200">
                        VNVDA
                    </div>
					<div>
                        <h1 class="text-2xl font-bold text-red-700 uppercase tracking-tight">Hội Bệnh Mạch Máu Việt Nam</h1>
                        <p class="text-sm text-gray-600 uppercase font-medium">Viet Nam Vascular Disease Association</p>
                    </div>
				</a>
                <div class="flex gap-2">
                    <input type="text" placeholder="Tìm kiếm..." class="border border-gray-300 rounded px-3 py-1.5 text-sm focus:outline-none focus:border-red-500" />
                    <button class="bg-red-600 text-white px-3 py-1.5 rounded text-sm hover:bg-red-700">Tìm kiếm</button>
                </div>
			</div>
		</div>

        <!-- Navigation Menu -->
        <nav class="bg-[#1a3b5c] sticky top-0 z-50 shadow-md border-b-4 border-red-600">
            <div class="max-w-6xl mx-auto px-4 flex justify-between items-center md:block relative">
                <!-- Mobile Toggle Button -->
                <button id="mobile-menu-btn" class="md:hidden block text-white p-3 hover:text-red-400 focus:outline-none ml-auto" aria-label="Toggle Navigation">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>

                <ul id="main-menu" class="hidden md:flex flex-col md:flex-row text-sm font-semibold text-white w-full absolute md:relative top-full left-0 bg-[#1a3b5c] md:bg-transparent shadow-md md:shadow-none z-50">
                    <li><a href="/" class="block px-4 py-3 hover:bg-red-600 transition-colors bg-red-600 border-b md:border-none border-[#2c4e71]">Trang chủ</a></li>

                    <li class="group relative">
                        <a href="#" class="block px-4 py-3 hover:bg-red-600 transition-colors border-b md:border-none border-[#2c4e71] flex justify-between items-center">
                            Giới thiệu
                            <svg class="w-4 h-4 ml-1 md:inline hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </a>
                        <!-- Submenu -->
                        <ul class="hidden md:group-hover:block absolute left-0 bg-white shadow-lg min-w-[200px] border-t-2 border-red-600 mobile-submenu">
                            <li><a href="#" class="block px-4 py-3 text-gray-800 hover:bg-gray-100 hover:text-red-600 transition-colors">Về chúng tôi</a></li>
                            <li><a href="#" class="block px-4 py-3 text-gray-800 hover:bg-gray-100 hover:text-red-600 transition-colors border-t border-gray-100">Lịch sử hình thành</a></li>
                            <li><a href="#" class="block px-4 py-3 text-gray-800 hover:bg-gray-100 hover:text-red-600 transition-colors border-t border-gray-100">Ban chấp hành</a></li>
                        </ul>
                    </li>

                    <li class="group relative">
                        <a href="#" class="block px-4 py-3 hover:bg-red-600 transition-colors border-b md:border-none border-[#2c4e71] flex justify-between items-center">
                            Tin tức - Sự kiện
                            <svg class="w-4 h-4 ml-1 md:inline hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </a>
                        <ul class="hidden md:group-hover:block absolute left-0 bg-white shadow-lg min-w-[200px] border-t-2 border-red-600 mobile-submenu">
                            <li><a href="#" class="block px-4 py-3 text-gray-800 hover:bg-gray-100 hover:text-red-600 transition-colors">Hoạt động hội</a></li>
                            <li><a href="#" class="block px-4 py-3 text-gray-800 hover:bg-gray-100 hover:text-red-600 transition-colors border-t border-gray-100">Cập nhật y khoa</a></li>
                            <li><a href="#" class="block px-4 py-3 text-gray-800 hover:bg-gray-100 hover:text-red-600 transition-colors border-t border-gray-100">Hợp tác quốc tế</a></li>
                        </ul>
                    </li>

                    <li class="group relative">
                        <a href="#" class="block px-4 py-3 hover:bg-red-600 transition-colors border-b md:border-none border-[#2c4e71] flex justify-between items-center">
                            Hội viên
                            <svg class="w-4 h-4 ml-1 md:inline hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </a>
                        <ul class="hidden md:group-hover:block absolute left-0 bg-white shadow-lg min-w-[200px] border-t-2 border-red-600 mobile-submenu">
                            <li><a href="#" class="block px-4 py-3 text-gray-800 hover:bg-gray-100 hover:text-red-600 transition-colors">Đăng ký</a></li>
                            <li><a href="#" class="block px-4 py-3 text-gray-800 hover:bg-gray-100 hover:text-red-600 transition-colors border-t border-gray-100">Hội phí</a></li>
                            <li><a href="#" class="block px-4 py-3 text-gray-800 hover:bg-gray-100 hover:text-red-600 transition-colors border-t border-gray-100">Danh sách hội viên</a></li>
                        </ul>
                    </li>

                    <li><a href="#" class="block px-4 py-3 hover:bg-red-600 transition-colors border-b md:border-none border-[#2c4e71]">Tài liệu Y khoa</a></li>
                    <li><a href="#" class="block px-4 py-3 hover:bg-red-600 transition-colors border-b md:border-none border-[#2c4e71]">Liên hệ</a></li>

                    <li class="md:ml-auto mt-2 md:mt-0 mb-2 md:mb-0 px-4 md:px-0">
                        <a href="/admin" class="block md:inline-block px-4 py-2 md:py-3 bg-gray-800 hover:bg-gray-700 transition-colors text-center rounded md:rounded-none">Đăng nhập</a>
                    </li>
                </ul>
            </div>
        </nav>

		<!-- Main Content -->
		<main class="flex-1 w-full max-w-6xl mx-auto p-4 py-8">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="bg-[#1a3b5c] text-white pt-10 pb-6 border-t-4 border-red-600">
			<div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
                <div>
                    <h3 class="text-xl font-bold uppercase mb-4 text-red-400">Hội Bệnh Mạch Máu VN</h3>
                    <p class="text-sm text-gray-300 leading-relaxed mb-4">Tổ chức xã hội - nghề nghiệp của công dân, tổ chức Việt Nam hoạt động trong lĩnh vực chuyên ngành bệnh mạch máu.</p>
                </div>
                <div>
                    <h3 class="text-xl font-bold uppercase mb-4 text-red-400">Liên hệ</h3>
                    <ul class="text-sm text-gray-300 space-y-2">
                        <li>📍 Địa chỉ: Hà Nội, Việt Nam</li>
                        <li>✉️ Email: info@vnvda.com</li>
                        <li>📞 Điện thoại: (024) 1234 5678</li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-xl font-bold uppercase mb-4 text-red-400">Liên kết</h3>
                    <ul class="text-sm text-gray-300 space-y-2">
                        <li><a href="#" class="hover:text-white transition-colors">Bệnh viện Hữu nghị Việt Đức</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Bộ Y Tế</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Hội Phẫu Thuật Tim Mạch</a></li>
                    </ul>
                </div>
			</div>
            <div class="text-center text-sm text-gray-400 border-t border-gray-700 pt-6">
                &copy; {new Date().getFullYear()} Hội Bệnh Mạch Máu Việt Nam. All Rights Reserved. (Mô phỏng Giao diện)
            </div>
		</footer>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const mobileMenuBtn = document.getElementById('mobile-menu-btn');
                const mainMenu = document.getElementById('main-menu');
                const parentMenuItems = document.querySelectorAll('#main-menu > li.group > a');

                if (mobileMenuBtn && mainMenu) {
                    mobileMenuBtn.addEventListener('click', () => {
                        mainMenu.classList.toggle('hidden');
                    });
                }

                // Handle submenu toggling on mobile
                parentMenuItems.forEach(item => {
                    item.addEventListener('click', (e) => {
                        if (window.innerWidth < 768) { // Only active on mobile
                            e.preventDefault();
                            const submenu = item.nextElementSibling;
                            if (submenu && submenu.classList.contains('mobile-submenu')) {
                                submenu.classList.toggle('hidden');
                                // Reset position for mobile flow
                                if (!submenu.classList.contains('hidden')) {
                                    submenu.classList.remove('absolute', 'shadow-lg');
                                    submenu.classList.add('relative', 'w-full', 'bg-[#152e48]', 'text-white');

                                    // Make submenu links match mobile theme
                                    const links = submenu.querySelectorAll('a');
                                    links.forEach(l => {
                                        l.classList.remove('text-gray-800', 'hover:bg-gray-100', 'hover:text-red-600', 'border-gray-100');
                                        l.classList.add('hover:bg-red-600', 'border-[#2c4e71]');
                                    });
                                } else {
                                    submenu.classList.add('absolute', 'shadow-lg');
                                    submenu.classList.remove('relative', 'w-full', 'bg-[#152e48]', 'text-white');
                                }
                            }
                        }
                    });
                });
            });
        </script>
	</body>
</html>
