---
import Layout from './Layout.astro';
import { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/card';

const getNews = async () => {
  try {
    // @ts-ignore: Astro.glob is available in Astro components but types might not be perfectly inferred here
    const allPosts = await Astro.glob('../../pages/posts/*.md');
    return allPosts.map((post: any) => ({
      title: post.frontmatter.title,
      desc: post.frontmatter.desc,
      date: post.frontmatter.date,
      image: post.frontmatter.image,
      url: post.url
    }));
  } catch (e) {
    // Fallback if no posts
    return [
      { title: "Hội nghị khoa học toàn quốc Hội Bệnh Mạch Máu Việt Nam 2024", date: "15/10/2023", image: "https://via.placeholder.com/600x400?text=Hoi+Nghi+Mach+Mau", url: "#" },
      { title: "Cập nhật Hướng dẫn chẩn đoán và điều trị bệnh động mạch ngoại biên", date: "02/11/2023", image: "https://via.placeholder.com/600x400?text=Huong+Dan+Dieu+Tri", url: "#" },
      { title: "Sinh hoạt khoa học chuyên đề: Phình động mạch chủ bụng", date: "20/11/2023", image: "https://via.placeholder.com/600x400?text=Sinh+Hoat+Khoa+Hoc", url: "#" },
      { title: "Thông báo nộp phí hội viên năm 2024", date: "05/12/2023", image: "https://via.placeholder.com/600x400?text=Thong+Bao", url: "#" },
    ];
  }
};

const news = await getNews();
---

<Layout>
    <div class="flex flex-col lg:flex-row gap-8">

        <!-- Cột nội dung chính (70%) -->
        <div class="lg:w-2/3">
            <!-- Breadcrumb -->
            <div class="text-sm text-gray-500 mb-6 flex items-center gap-2 border-b pb-2">
                <a href="/" class="hover:text-red-600">Trang chủ</a>
                <span>&raquo;</span>
                <span class="text-gray-800 font-medium">Tin tức nổi bật</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {news.map((item: any, index: number) => {
                    // Bài viết đầu tiên làm nổi bật
                    if(index === 0) {
                        return (
                            <div class="md:col-span-2 relative group overflow-hidden bg-white shadow-md border rounded">
                                <img src={item.image} alt={item.title} class="w-full h-80 object-cover group-hover:scale-105 transition-transform duration-500" />
                                <div class="absolute bottom-0 w-full bg-gradient-to-t from-gray-900 via-gray-900/80 to-transparent p-6">
                                    <div class="text-red-400 text-sm font-bold mb-2">{item.date}</div>
                                    <h2 class="text-2xl font-bold text-white leading-snug">
                                        <a href={item.url} class="hover:text-red-300">{item.title}</a>
                                    </h2>
                                </div>
                            </div>
                        )
                    }

                    // Các bài viết bình thường
                    return (
                        <Card className="hover:shadow-md transition-shadow overflow-hidden bg-white border-gray-200">
                            <a href={item.url} class="block">
                                <img src={item.image} alt={item.title} class="w-full h-40 object-cover border-b" />
                            </a>
                            <CardHeader className="p-4 pb-2">
                                <div class="text-xs text-gray-500 font-medium mb-1">📅 {item.date}</div>
                                <CardTitle className="text-base leading-snug line-clamp-2">
                                    <a href={item.url} class="hover:text-red-600 transition-colors text-gray-800">{item.title}</a>
                                </CardTitle>
                            </CardHeader>
                            <CardContent className="p-4 pt-0">
                                <p class="text-sm text-gray-600 line-clamp-2">{item.desc || "Nội dung tóm tắt của tin tức. Hãy bấm vào để xem chi tiết đầy đủ cập nhật y khoa và thông báo mới nhất."}</p>
                            </CardContent>
                        </Card>
                    )
                })}
            </div>

            <div class="mt-8 text-center">
                <a href="#" class="inline-block border-2 border-[#1a3b5c] text-[#1a3b5c] px-6 py-2 rounded font-semibold hover:bg-[#1a3b5c] hover:text-white transition-colors">Xem thêm tin tức</a>
            </div>
        </div>

        <!-- Cột Sidebar (30%) -->
        <div class="lg:w-1/3 space-y-8">
            <!-- Widget Thông báo -->
            <div class="bg-white border shadow-sm p-5 border-t-4 border-t-red-600">
                <h3 class="text-lg font-bold text-[#1a3b5c] mb-4 pb-2 border-b">Thông báo mới</h3>
                <ul class="space-y-3 text-sm">
                    <li class="flex gap-3 items-start">
                        <span class="text-red-600 mt-1">▶</span>
                        <a href="#" class="hover:text-red-600 text-gray-700">Mời tham dự Đại hội Đại biểu toàn quốc nhiệm kỳ 2024-2029</a>
                    </li>
                    <li class="flex gap-3 items-start">
                        <span class="text-red-600 mt-1">▶</span>
                        <a href="#" class="hover:text-red-600 text-gray-700">Chương trình đào tạo CME chuyên khoa mạch máu tháng 12</a>
                    </li>
                    <li class="flex gap-3 items-start">
                        <span class="text-red-600 mt-1">▶</span>
                        <a href="#" class="hover:text-red-600 text-gray-700">Thể lệ gửi bài đăng tạp chí y học</a>
                    </li>
                </ul>
            </div>

            <!-- Widget Banner/Quảng cáo -->
            <div class="bg-gray-100 p-4 border text-center">
                <div class="w-full h-48 bg-gray-300 flex items-center justify-center text-gray-500 font-bold border-2 border-dashed border-gray-400">
                    Banner Quảng cáo / Tài trợ
                </div>
            </div>

            <!-- Widget Chuyên mục -->
            <div class="bg-white border shadow-sm p-5 border-t-4 border-t-[#1a3b5c]">
                <h3 class="text-lg font-bold text-[#1a3b5c] mb-4 pb-2 border-b">Chuyên mục</h3>
                <ul class="space-y-2 text-sm divide-y">
                    <li class="pt-2"><a href="#" class="hover:text-red-600 flex justify-between"><span>Hoạt động Hội</span> <span class="bg-gray-100 text-xs px-2 py-0.5 rounded text-gray-600">12</span></a></li>
                    <li class="pt-2"><a href="#" class="hover:text-red-600 flex justify-between"><span>Kiến thức Y khoa</span> <span class="bg-gray-100 text-xs px-2 py-0.5 rounded text-gray-600">45</span></a></li>
                    <li class="pt-2"><a href="#" class="hover:text-red-600 flex justify-between"><span>Hợp tác Quốc tế</span> <span class="bg-gray-100 text-xs px-2 py-0.5 rounded text-gray-600">8</span></a></li>
                    <li class="pt-2"><a href="#" class="hover:text-red-600 flex justify-between"><span>Video Bài giảng</span> <span class="bg-gray-100 text-xs px-2 py-0.5 rounded text-gray-600">23</span></a></li>
                </ul>
            </div>
        </div>

    </div>
</Layout>
