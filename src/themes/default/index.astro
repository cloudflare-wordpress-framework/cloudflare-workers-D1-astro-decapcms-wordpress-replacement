---
import Layout from './Layout.astro';
import { Card, CardHeader, CardTitle, CardContent, CardFooter } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import Comment from '../../plugins/plugin-comment-system/Comment.astro';
import config from '../../plugins/plugins.config.json';

const getPosts = async () => {
  try {
    // @ts-ignore: Astro.glob is available in Astro components but types might not be perfectly inferred here
    const allPosts = await Astro.glob('../../pages/posts/*.md');
    return allPosts.map((post: any) => ({
      title: post.frontmatter.title,
      desc: post.frontmatter.desc,
      date: post.frontmatter.date,
      image: post.frontmatter.image,
      url: post.url
    }));
  } catch (e) {
    // Fallback if no posts
    return [
      { title: "Hướng dẫn tối ưu hóa SEO với Astro", desc: "Khám phá các kỹ thuật tăng tốc độ tải trang và SEO On-page cho hệ thống SSG.", date: "2024-01-01", image: "https://via.placeholder.com/600x400?text=SEO+Astro", url: "/posts/huong-dan-seo" },
      { title: "Chuyển đổi WordPress sang Jamstack", desc: "Lợi ích tuyệt vời của việc rời bỏ PHP và MySQL để chuyển sang kiến trúc tĩnh hoàn toàn.", date: "2024-01-02", image: "https://via.placeholder.com/600x400?text=WordPress+to+Jamstack", url: "/posts/chuyen-doi-wordpress" },
      { title: "Cách sử dụng Cloudflare D1", desc: "Thiết lập cơ sở dữ liệu SQLite chạy trực tiếp trên Edge của Cloudflare.", date: "2024-01-05", image: "https://via.placeholder.com/600x400?text=Cloudflare+D1", url: "/posts/cloudflare-d1" },
    ];
  }
};

const posts = await getPosts();

const isCommentActive = config.active_plugins.includes('plugin-comment-system');
---
<Layout>
  <!-- Hero Section -->
  <section class="mb-12 py-12 px-6 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl border shadow-sm text-center">
    <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight mb-4">
      Khám phá kiến thức <span class="text-blue-600">Jamstack</span>
    </h1>
    <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-8">
      Blog chuyên chia sẻ các bài viết kỹ thuật, hướng dẫn cấu hình và trải nghiệm chuyển đổi hệ thống website hiện đại, tối ưu chi phí.
    </p>
    <div class="flex justify-center gap-4">
      <a href="/admin/cms.html">
        <Button size="lg" className="font-semibold">Tạo Bài Mới</Button>
      </a>
      <a href="/admin/settings">
        <Button variant="outline" size="lg" className="font-semibold">Cài đặt User</Button>
      </a>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="mb-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-gray-900 border-l-4 border-blue-600 pl-3">Bài viết mới nhất</h2>
      <a href="#" class="text-blue-600 hover:text-blue-800 text-sm font-medium">Xem tất cả &rarr;</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post: any) => (
        <Card className="overflow-hidden hover:shadow-lg transition-shadow duration-300 flex flex-col">
          <a href={post.url} class="block">
            <img src={post.image} alt={post.title} class="w-full h-48 object-cover border-b" />
          </a>
          <CardHeader>
            <div class="text-xs text-blue-600 font-semibold mb-1">{post.date}</div>
            <CardTitle className="text-xl leading-tight line-clamp-2 hover:text-blue-600 transition-colors">
              <a href={post.url}>{post.title}</a>
            </CardTitle>
          </CardHeader>
          <CardContent className="flex-1">
            <p class="text-gray-600 text-sm line-clamp-3">{post.desc}</p>
          </CardContent>
          <CardFooter className="pt-0">
            <a href={post.url} class="text-sm font-medium text-gray-900 hover:text-blue-600 flex items-center gap-1">
              Đọc tiếp
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </CardFooter>
        </Card>
      ))}
    </div>
  </section>

  <!-- Nhúng Plugin Comment Test -->
  {isCommentActive && (
    <section class="max-w-3xl mx-auto">
      <div class="border-t pt-8">
        <Comment />
      </div>
    </section>
  )}
</Layout>
