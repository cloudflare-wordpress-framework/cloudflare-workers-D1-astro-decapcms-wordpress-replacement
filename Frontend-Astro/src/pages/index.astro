import DefaultTheme from '../themes/default/index.astro';
import VnvdaTheme from '../themes/vnvda/index.astro';

// Theme Router: Render component based on active theme
const activeTheme = config.active_theme;
---

{activeTheme === 'vnvda' ? <VnvdaTheme /> : <DefaultTheme />}
