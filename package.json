{
  "name": "app",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:env": "node scripts/env-setup.js",
    "dev": "npm run setup:env && astro dev",
    "dev:worker": "npm run setup:env && wrangler dev src/workers/index.js --local",
    "test:unit": "vitest run",
    "test:seo": "astro check",
    "test:all": "npm run test:unit && npm run test:seo",
    "clean": "rimraf .astro dist .wrangler",
    "build": "npm run setup:env && npm run clean && astro build",
    "deploy:database": "wrangler d1 migrations apply user-db --remote",
    "deploy:worker": "wrangler deploy src/workers/index.js",
    "deploy:pages": "wrangler pages deploy dist --project-name=my-astro-site",
    "deploy": "npm run setup:env && npm run test:all && npm run build && npm run deploy:database && npm run deploy:worker && npm run deploy:pages",
    "preview": "npm run setup:env && astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.1",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.21.0",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^6.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  }
}
