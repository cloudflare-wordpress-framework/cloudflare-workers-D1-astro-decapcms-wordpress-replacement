{
  "name": "app",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:env": "node Frontend-Astro/scripts/env-setup.js",
    "dev": "npm run setup:env && cd Frontend-Astro && astro dev",
    "dev:worker": "npm run setup:env && cd Backend-worker && wrangler dev workers/index.js --local",
    "test:unit": "vitest run",
    "test:seo": "cd Frontend-Astro && astro check",
    "test:keystatic": "node Frontend-Astro/scripts/verify-keystatic-env.js",
    "test:all": "npm run test:unit && npm run test:seo && npm run test:keystatic",
    "clean": "rimraf Frontend-Astro/.astro Frontend-Astro/dist",
    "build": "npm run setup:env && npm run clean && cd Frontend-Astro && astro build && node scripts/clean-build-secrets.js",
    "deploy:database": "cd Backend-worker && wrangler d1 migrations apply user-db --remote",
    "deploy:worker": "cd Backend-worker && wrangler deploy workers/index.js",
    "deploy:pages:secrets": "node Frontend-Astro/scripts/sync-keystatic-secrets.js",
    "deploy:pages": "cd Frontend-Astro && wrangler deploy",
    "deploy:pages:dry-run": "cd Frontend-Astro && wrangler deploy --dry-run",
    "deploy": "npm run setup:env && npm run test:all && npm run build && npm run deploy:database && npm run deploy:worker && npm run deploy:pages:secrets && npm run deploy:pages",
    "preview": "npm run setup:env && cd Frontend-Astro && astro preview",
    "astro": "cd Frontend-Astro && astro",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:worker\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/markdoc": "^1.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@keystatic/astro": "^5.1.0",
    "@keystatic/core": "^0.5.50",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.21.0",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.2",
    "@astrojs/node": "^10.1.4",
    "@astrojs/react": "^5.0.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  }
}
